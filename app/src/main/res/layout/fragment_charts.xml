<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chart_column" />

        <Spinner
            android:id="@+id/spinner_chart_col"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/histogram_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.pocketstat.app.HistogramView
            android:id="@+id/histogram_view"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/boxplot_title"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.pocketstat.app.BoxPlotView
            android:id="@+id/boxplot_view"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
